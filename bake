#!/usr/bin/env bash

# nsfu
cd "$(dirname "$0")"
if [ -f ".env" ]; then
  export $(grep -v '^#' .env | xargs -d '\n')
fi

INSTALL_DIR=`eval echo $INSTALL_DIR`
set -x

if [ "$1" = "run" ]; then
  go run .
elif [ "$1" = "dev" ]; then
  export DEV=1
  go run .
elif [ "$1" = "install" ]; then
  go install .
elif [ "$1" = "uninstall" ]; then
  rm -f "$(go env GOPATH)/bin/yams"
elif [ "$1" = "build" ]; then
  ${BUILD_CMD:-go build -o yams .}
elif [ "$1" = "test" ]; then
  go test ./...
elif [ "$1" = "clean" ]; then
  rm -f yams
else
  set +x
  echo "Shiver me timbers!!.. Invalid arrghh - $1"
  exit 1
fi
